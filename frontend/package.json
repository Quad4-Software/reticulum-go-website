{
	"name": "frontend",
	"private": true,
	"license": "SEE LICENSE IN ../LICENSE",
	"version": "1.5.0",
	"packageManager": "pnpm@12.21.0",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=26.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/generate-sri.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run",
		"lhci": "lhci autorun",
		"update-micron-wasm": "node ../scripts/update-micron-wasm.mjs"
	},
	"devDependencies": {
		"@lhci/cli": "0.16.1",
		"@lucide/svelte": "^1.77.0",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vite-pwa/sveltekit": "^2.0.3",
		"@vitest/coverage-v8": "^5.1.1",
		"autoprefixer": "^10.7.0",
		"eslint": "^10.15.0",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-svelte": "^3.24.1",
		"fake-indexeddb": "^6.2.8",
		"globals": "^17.14.0",
		"jsdom": "^31.0.1",
		"mdsvex": "^0.12.8",
		"postcss": "^8.5.33",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-slug": "^6.0.0",
		"shiki": "^4.6.0",
		"svelte": "^5.59.0",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"dompurify": "^3.4.18",
		"fuse.js": "^7.5.0",
		"isomorphic-dompurify": "^4.8.0",
		"jszip": "^3.10.2",
		"marked": "^18.2.1",
		"svelte-i18n": "^4.0.1"
	}
}
